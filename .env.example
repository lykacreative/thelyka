# Database (same URI on Production and Preview)
MONGODB_URI=
# Preview only: the preview's own database inside that cluster, e.g. thelyka_preview.
# Leave unset on Production (the database named in MONGODB_URI is used).
# LYKA_DB_NAME=

# Admin sign-in: Google, only for the emails listed (comma separated)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LYKA_ADMIN_EMAILS=
# Long random string that signs the admin session cookie
LYKA_SESSION_SECRET=
# Old password sign-in: shown only while this is set. Delete it once Google sign-in works.
# LYKA_ADMIN_PASSWORD=

# Cloudinary (uploads go straight from the browser; deletes only inside LYKA_CLOUDINARY_ROOT)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder for new uploads. Defaults: thelyka on Production, thelyka-preview everywhere else.
# LYKA_CLOUDINARY_ROOT=
